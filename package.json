{
  "name": "nebula-media",
  "productName": "Nebula",
  "version": "0.1.0",
  "description": "星云影库 — 桌面媒体库与播放器，支持网盘挂载、自动归类、内嵌 mpv 播放",
  "main": "dist/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "icon": "python scripts/make-icon.py",
    "vendor:mpv": "node scripts/vendor-mpv.mjs",
    "pack:dir": "npm run build && node scripts/vendor-mpv.mjs && electron-builder --win --x64 --dir",
    "pack": "npm run build && node scripts/vendor-mpv.mjs && electron-builder --win --x64",
    "deploy": "node scripts/deploy-desktop.mjs --shortcut",
    "pack:deploy": "npm run pack && node scripts/deploy-desktop.mjs --shortcut"
  },
  "build": {
    "appId": "com.nebula.mediaplayer",
    "productName": "Nebula",
    "copyright": "Copyright © 2026 Nebula",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "vendor/mpv",
        "to": "mpv"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "星云影库",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
